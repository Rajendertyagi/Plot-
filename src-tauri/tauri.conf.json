{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectFlow",
  "version": "1.0.0",
  "identifier": "com.projectflow.portable",
  "build": {
    "devUrl": "http://localhost:4000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectFlow - Project & Task Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
